---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { bodyClass = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es-HN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-B9L2HSP4B6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-B9L2HSP4B6');
    </script>
    
    <!-- Favicon + PWA -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#7c3aed">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="LotoHN">
    
    <!-- Preconexiones -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">

    <!-- Tipografía con personalidad: Outfit (display) + DM Sans (cuerpo) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&family=DM+Sans:wght@400;500;600;700&display=swap">

    <!-- Preload logos críticos -->
    <link rel="preload" href="/logos/juga3.png" as="image">
    <link rel="preload" href="/logos/pega3.png" as="image">
    <link rel="preload" href="/logos/premia2.png" as="image">
    <link rel="preload" href="/logos/la_diaria.png" as="image">
    <link rel="preload" href="/logos/super_premio.png" as="image">

    <!-- Estilos dinámicos -->
    <link rel="stylesheet" href="/styles_dinamicos.css">
    
    <!-- Registro Service Worker (PWA instalable, sin caché offline) -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>

    <!-- Monetag -->
    <meta name="monetag" content="7c18f2290e896637ac9b67ada7270ad8">

    <!-- Organization (entidad de marca) — global en todo el sitio -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://lotohn.com/#organization",
      "name": "LotoHN",
      "alternateName": "Loto Honduras",
      "url": "https://lotohn.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://lotohn.com/logo.png",
        "width": 512,
        "height": 512
      },
      "description": "Portal de resultados de las loterías de Honduras: Jugá 3, Pega 3, Premia 2, La Diaria y Súper Premio.",
      "areaServed": [
        { "@type": "Country", "name": "Honduras" },
        { "@type": "Country", "name": "Costa Rica" },
        { "@type": "Country", "name": "United States" }
      ],
      "sameAs": ["https://twitter.com/LotoHN"]
    }
    </script>

    <!-- Slot para SEO de cada página -->
    <slot name="head" />
</head>
<body class={`bg-gradient-to-br from-violet-50 via-purple-50 to-fuchsia-50 min-h-screen ${bodyClass}`}>
    <Header />
    <div class="max-w-7xl mx-auto pt-4">
        <main class="p-4 md:p-6">

            <!-- Contenido de cada página -->
            <slot />

        </main>
    </div>
    
    <Footer />
    
    <!-- Scripts globales -->
    <script src="../scripts/main.js"></script>

    <!-- Monetag In-Page Push -->
    <script is:inline>(function(s){s.dataset.zone='11097782',s.src='https://nap5k.com/tag.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>

    <!-- Monetag Vignette Banner -->
    <script is:inline>(function(s){s.dataset.zone='11097785',s.src='https://n6wxm.com/vignette.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>

    <script is:inline>(function(s){s.dataset.zone='11098019',s.src='https://al5sm.com/tag.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>

</body>
</html>

<style is:global>
    :root {
        --font-display: 'Outfit', system-ui, -apple-system, 'Segoe UI', sans-serif;
        --font-body: 'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    }

    html, body {
        overflow-x: hidden;
        max-width: 100%;
    }

    body {
        font-family: var(--font-body);
        /* Patrón de puntos muy tenue sobre el gradiente violeta */
        background-image:
            radial-gradient(circle at 1px 1px, rgba(124, 58, 237, 0.06) 1px, transparent 0);
        background-size: 26px 26px;
        background-attachment: fixed;
    }

    /* Títulos con la fuente display (sin tocar el contenido) */
    h1, h2, h3, .game-name, .sorteo-header, .hist-title {
        font-family: var(--font-display);
    }

    /* Números siempre alineados (tabular) */
    .bola, .mas1-num, #relojHonduras, .td-num, .td-fecha {
        font-variant-numeric: tabular-nums;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    .animate-spin {
        animation: spin 1s linear infinite;
    }
    @keyframes pulse-scale {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }
    .animate-pulse-scale {
        animation: pulse-scale 2s ease-in-out infinite;
    }
</style>
