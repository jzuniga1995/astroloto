<script>
const HISTORIAL_URL = '/api/historial';

const JUEGOS = [
    { key: 'juga3',       label: 'Jugá 3',      color: '#7c3aed', bg: '#f5f3ff' },
    { key: 'pega3',       label: 'Pega 3',       color: '#0369a1', bg: '#f0f9ff' },
    { key: 'premia2',     label: 'Premia 2',     color: '#065f46', bg: '#f0fdf4' },
    { key: 'la_diaria',   label: 'La Diaria',    color: '#9a3412', bg: '#fff7ed' },
    { key: 'super_premio',label: 'Súper Premio', color: '#b45309', bg: '#fffbeb' },
];

const TOP_N = 12;

function detectarJuego(key) {
    if (key.includes('juga3')   || key.includes('juga_3'))   return 'juga3';
    if (key.includes('pega3')   || key.includes('pega_3'))   return 'pega3';
    if (key.includes('premia2') || key.includes('premia_2')) return 'premia2';
    if (key.includes('diaria'))                               return 'la_diaria';
    if (key.includes('super'))                                return 'super_premio';
    return null;
}

function extraerNumeros(datos, juegoKey) {
    // Nuevo formato: datos es array directo; viejo formato: objeto con campos
    const arr = Array.isArray(datos)
        ? datos
        : (datos?.numeros_adicionales?.length ? datos.numeros_adicionales : datos?.numeros_individuales);

    if (!arr?.length) {
        if (datos?.numero_ganador) return [String(datos.numero_ganador).trim()];
        return [];
    }

    if (juegoKey === 'super_premio') {
        // Todas las bolas numéricas (6 por sorteo)
        return arr.map(n => String(n).trim()).filter(n => n && !isNaN(n));
    }

    if (juegoKey === 'la_diaria') {
        // Solo el primer elemento numérico (ignora signo y Más1)
        const num = arr.find(n => !isNaN(String(n).trim()) && String(n).trim() !== '');
        return num ? [String(num).trim()] : [];
    }

    // juga3, pega3, premia2: primer elemento = número ganador
    const first = arr[0];
    return first ? [String(first).trim()] : [];
}

function calcularFrecuencias(historialData) {
    const frecuencias   = {};
    const conteoSorteos = {};
    JUEGOS.forEach(j => { frecuencias[j.key] = {}; conteoSorteos[j.key] = 0; });

    Object.values(historialData).forEach(diaData => {
        Object.entries(diaData).forEach(([key, datos]) => {
            const juego = detectarJuego(key);
            if (!juego || !frecuencias[juego]) return;
            conteoSorteos[juego]++;                        // sorteos reales siempre +1
            const nums = extraerNumeros(datos, juego);
            nums.forEach(n => {
                if (n) frecuencias[juego][n] = (frecuencias[juego][n] || 0) + 1;
            });
        });
    });

    return { frecuencias, conteoSorteos };
}

function renderBarChart(entries, color, maxVal) {
    return entries.map(([num, count]) => {
        const pct = maxVal > 0 ? Math.round((count / maxVal) * 100) : 0;
        return `
            <div class="stat-bar-row">
                <span class="stat-num">${num}</span>
                <div class="stat-bar-wrap">
                    <div class="stat-bar" style="width:${pct}%;background:${color}"></div>
                </div>
                <span class="stat-count">${count}x</span>
            </div>
        `;
    }).join('');
}

function renderEstadisticas(historialData) {
    const loading = document.getElementById('stats-loading');
    const contenido = document.getElementById('stats-contenido');
    if (loading) loading.style.display = 'none';
    if (!contenido) return;

    const { frecuencias, conteoSorteos } = calcularFrecuencias(historialData);
    const totalDias = Object.keys(historialData).length;

    let html = `
    <style>
        .stats-resumen {
            background:#fff;
            border:1px solid #ede9fe;
            border-radius:1rem;
            padding:1rem 1.25rem;
            margin-bottom:1.5rem;
            display:flex;
            gap:1rem;
            flex-wrap:wrap;
            align-items:center;
            box-shadow:0 1px 4px rgba(0,0,0,.06);
        }
        .stats-resumen-item {
            display:flex;
            flex-direction:column;
            align-items:center;
            gap:.15rem;
            min-width:80px;
        }
        .stats-resumen-val {
            font-size:1.5rem;
            font-weight:900;
            color:#7c3aed;
            line-height:1;
        }
        .stats-resumen-lbl {
            font-size:.72rem;
            color:#6b7280;
            font-weight:600;
            text-align:center;
        }
        .stats-tabs {
            display:flex;
            gap:.4rem;
            flex-wrap:nowrap;
            overflow-x:auto;
            padding-bottom:4px;
            margin-bottom:1.25rem;
            scrollbar-width:none;
        }
        .stats-tabs::-webkit-scrollbar { display:none; }
        .stats-tab {
            padding:.4rem 1rem;
            border-radius:9999px;
            font-size:.8rem;
            font-weight:700;
            border:1.5px solid #ede9fe;
            background:#fff;
            color:#7c3aed;
            cursor:pointer;
            white-space:nowrap;
            transition:all .15s;
            -webkit-tap-highlight-color:transparent;
        }
        .stats-tab:hover { background:#f5f3ff; }
        .stats-tab.active { color:#fff; border-color:transparent; }
        .stats-panel { display:none; }
        .stats-panel.active { display:block; }
        .stats-card {
            background:#fff;
            border:1px solid #ede9fe;
            border-radius:1rem;
            overflow:hidden;
            box-shadow:0 1px 4px rgba(0,0,0,.06),0 4px 16px rgba(92,33,182,.06);
            margin-bottom:1.25rem;
        }
        .stats-card-header {
            padding:.85rem 1.25rem;
            font-size:.85rem;
            font-weight:800;
            letter-spacing:.04em;
            text-transform:uppercase;
            display:flex;
            align-items:center;
            gap:.5rem;
        }
        .stats-card-body {
            padding:.75rem 1.25rem 1rem;
        }
        .stat-bar-row {
            display:flex;
            align-items:center;
            gap:.6rem;
            margin-bottom:.55rem;
        }
        .stat-num {
            font-size:.82rem;
            font-weight:800;
            min-width:52px;
            text-align:right;
            font-family:'JetBrains Mono','Fira Mono',ui-monospace,monospace;
            color:#1e1b4b;
        }
        .stat-bar-wrap {
            flex:1;
            height:18px;
            background:#f3f4f6;
            border-radius:9999px;
            overflow:hidden;
        }
        .stat-bar {
            height:100%;
            border-radius:9999px;
            transition:width .4s cubic-bezier(.4,0,.2,1);
            min-width:4px;
        }
        .stat-count {
            font-size:.78rem;
            font-weight:700;
            color:#6b7280;
            min-width:32px;
            text-align:right;
        }
        .stats-two-col {
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:1rem;
        }
        @media (max-width:600px) {
            .stats-two-col { grid-template-columns:1fr; }
        }
        .stats-empty {
            padding:2rem;
            text-align:center;
            color:#9ca3af;
            font-size:.88rem;
        }
        .stats-total-badge {
            background:#f3e8ff;
            color:#7c3aed;
            font-size:.72rem;
            font-weight:700;
            padding:.2rem .6rem;
            border-radius:9999px;
            margin-left:auto;
        }
    </style>

    <div class="stats-resumen">
        <div class="stats-resumen-item">
            <span class="stats-resumen-val">${totalDias}</span>
            <span class="stats-resumen-lbl">Días de historial</span>
        </div>
        ${JUEGOS.map(j => `
            <div class="stats-resumen-item">
                <span class="stats-resumen-val" style="color:${j.color}">${conteoSorteos[j.key]}</span>
                <span class="stats-resumen-lbl">${j.label}<br>sorteos</span>
            </div>`
        ).join('')}
    </div>

    <div class="stats-tabs" id="stats-tabs" role="tablist">
        ${JUEGOS.map((j, i) => `
            <button class="stats-tab${i === 0 ? ' active' : ''}"
                style="${i === 0 ? `background:${j.color}` : ''}"
                data-juego="${j.key}"
                data-color="${j.color}"
                data-bg="${j.bg}"
                role="tab"
                aria-selected="${i === 0}"
                aria-controls="panel-${j.key}">
                ${j.label}
            </button>
        `).join('')}
    </div>
    `;

    JUEGOS.forEach((juego, i) => {
        const freqs   = frecuencias[juego.key];
        const sorted  = Object.entries(freqs).sort((a, b) => b[1] - a[1]);
        const calientes = sorted.slice(0, TOP_N);
        const frios     = sorted.slice(-TOP_N).reverse();
        const maxVal    = calientes.length ? calientes[0][1] : 1;
        const totalSorteos = conteoSorteos[juego.key];

        html += `
        <div class="stats-panel${i === 0 ? ' active' : ''}" id="panel-${juego.key}" role="tabpanel">
            ${sorted.length === 0 ? `<div class="stats-empty">Sin datos suficientes para ${juego.label}.</div>` : `
            <div class="stats-two-col">
                <div class="stats-card">
                    <div class="stats-card-header" style="background:${juego.bg};color:${juego.color}">
                        🔥 Números Calientes
                        <span class="stats-total-badge">${totalSorteos} sorteos</span>
                    </div>
                    <div class="stats-card-body">
                        ${renderBarChart(calientes, juego.color, maxVal)}
                    </div>
                </div>
                <div class="stats-card">
                    <div class="stats-card-header" style="background:#f9fafb;color:#374151">
                        🧊 Números Fríos
                        <span class="stats-total-badge">${sorted.length} distintos</span>
                    </div>
                    <div class="stats-card-body">
                        ${renderBarChart(frios, '#9ca3af', frios.length ? frios[0][1] : 1)}
                    </div>
                </div>
            </div>
            `}
        </div>`;
    });

    contenido.innerHTML = html;

    document.getElementById('stats-tabs').addEventListener('click', e => {
        const btn = e.target.closest('.stats-tab');
        if (!btn) return;
        const juego = btn.dataset.juego;
        const color = btn.dataset.color;

        document.querySelectorAll('.stats-tab').forEach(b => {
            b.classList.remove('active');
            b.style.background = '';
        });
        btn.classList.add('active');
        btn.style.background = color;

        document.querySelectorAll('.stats-panel').forEach(p => p.classList.remove('active'));
        document.getElementById(`panel-${juego}`)?.classList.add('active');
    });
}

async function cargarEstadisticas() {
    try {
        const resp = await fetch('/api/historial', { cache: 'no-cache' });
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const data = await resp.json();
        renderEstadisticas(data);
    } catch (err) {
        const loading = document.getElementById('stats-loading');
        const contenido = document.getElementById('stats-contenido');
        if (loading) loading.style.display = 'none';
        if (contenido) contenido.innerHTML = `
            <div style="text-align:center;padding:2.5rem;color:#dc2626;font-size:.9rem;">
                <div style="font-size:2rem;margin-bottom:.75rem;">⚠️</div>
                No se pudieron cargar los datos.<br>
                <small style="color:#9ca3af;">${err.message}</small>
            </div>`;
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', cargarEstadisticas);
} else {
    cargarEstadisticas();
}
</script>
</Layout>
