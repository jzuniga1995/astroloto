---
// src/pages/estadisticas.astro
import Layout from '../layouts/Layout.astro';
import CoberturaPaises from '../components/CoberturaPaises.astro';
---

<Layout>

<header class="stats-header">
    <h1 class="stats-title">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Estadísticas de Resultados
    </h1>
    <p class="stats-subtitle">Análisis de frecuencias basado en el historial real de sorteos de Loto Honduras</p>
    <p style="color:#6b7280;font-size:.88rem;margin-top:.5rem;max-width:600px;margin-left:auto;margin-right:auto;">
        Consultá qué números han salido más veces (<strong>calientes</strong>) y cuáles menos (<strong>fríos</strong>) en Jugá 3, Pega 3, Premia 2, La Diaria y Súper Premio. Datos calculados sobre el historial real de sorteos.
    </p>
</header>

<div id="stats-loading" class="stats-loading" role="status" aria-live="polite">
    <div class="stats-spinner" aria-hidden="true"></div>
    <p class="stats-loading-text">Calculando estadísticas...</p>
</div>

<div id="stats-contenido"></div>

<!-- ============ CONTENIDO SEO VISIBLE ============ -->
<div style="margin-top:2rem;">

<style>
  .seo-section { background:#fff; border-radius:1rem; box-shadow:0 1px 6px rgba(124,58,237,.08); padding:1.5rem; margin-bottom:1.25rem; }
  .seo-section h2 { font-size:1.2rem; font-weight:800; color:#3b0764; margin-bottom:.875rem; display:flex; align-items:center; gap:.5rem; }
  .seo-section h3 { font-size:1rem; font-weight:700; color:#5b21b6; margin:1rem 0 .4rem; }
  .seo-section p { color:#374151; line-height:1.75; font-size:.95rem; margin-bottom:.75rem; }
  .seo-section ul { color:#374151; font-size:.95rem; padding-left:1.25rem; }
  .seo-section ul li { margin-bottom:.45rem; line-height:1.65; }
  .seo-section a { color:#7c3aed; font-weight:600; text-decoration:none; }
  .seo-section a:hover { text-decoration:underline; }
  .juego-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:1rem; margin:.875rem 0; }
  .juego-card { border-radius:.75rem; padding:1rem 1.25rem; border:1px solid #ede9fe; }
  .juego-card h3 { font-size:.95rem; font-weight:800; margin:0 0 .4rem; }
  .juego-card p { font-size:.88rem; color:#374151; margin:0; line-height:1.6; }
  .faq-item { border-bottom:1px solid #f3f4f6; padding:.875rem 0; }
  .faq-item:last-child { border-bottom:none; }
  .faq-item h3 { font-size:.95rem; font-weight:700; color:#3b0764; margin:0 0 .4rem; }
  .faq-item p { font-size:.9rem; color:#374151; margin:0; line-height:1.65; }
  .links-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:.75rem; margin-top:.875rem; }
  .link-card { background:#f5f3ff; border:1px solid #ede9fe; border-radius:.75rem; padding:.75rem 1rem; text-decoration:none; color:#5b21b6; font-weight:600; font-size:.85rem; transition:all .15s; display:flex; align-items:center; gap:.4rem; }
  .link-card:hover { background:#ede9fe; border-color:#c4b5fd; }
</style>

<!-- ¿Qué son? -->
<section class="seo-section">
    <h2>📊 ¿Qué son los Números Calientes y Fríos en Loto Honduras?</h2>
    <p>Las estadísticas de LotoHN analizan el <strong>historial completo de sorteos</strong> de Loto Honduras para identificar dos tipos de números:</p>
    <ul>
        <li><strong>Números calientes 🔥</strong> — Los que han aparecido con mayor frecuencia en los sorteos recientes. Muchos jugadores los prefieren basándose en la tendencia histórica.</li>
        <li><strong>Números fríos 🧊</strong> — Los que menos han salido en el historial. Algunos jugadores apuestan a que "ya les toca".</li>
    </ul>
    <p>Es importante entender que la lotería es un <strong>juego de azar</strong> — cada sorteo es independiente y las estadísticas históricas no garantizan resultados futuros. Sin embargo, conocer las frecuencias te permite tomar decisiones más informadas.</p>
</section>

<!-- Estadísticas por juego -->
<section class="seo-section">
    <h2>🎯 Estadísticas por Juego de Loto Honduras</h2>
    <div class="juego-grid">
        <div class="juego-card" style="background:#faf5ff;">
            <h3 style="color:#7c3aed;">🎯 Jugá 3</h3>
            <p>Estadísticas de los números de 3 dígitos (000–999). Con 263+ sorteos en el historial, podés ver cuáles combinaciones de tres dígitos se repiten más en las tandas de mañana, tarde y noche. <a href="/juga-3">Ver resultados Jugá 3 →</a></p>
        </div>
        <div class="juego-card" style="background:#f0f9ff;">
            <h3 style="color:#0369a1;">🎲 Pega 3</h3>
            <p>Análisis de frecuencias del número directo ganador de Pega 3. Descubrí qué combinaciones de 3 dígitos aparecen con más regularidad en los sorteos diarios de Honduras. <a href="/pega-3">Ver resultados Pega 3 →</a></p>
        </div>
        <div class="juego-card" style="background:#f0fdf4;">
            <h3 style="color:#065f46;">🏆 Premia 2</h3>
            <p>Estadísticas de los números de 2 dígitos (00–99) de Premia 2. Con solo 100 combinaciones posibles, las frecuencias son más notorias y útiles para elegir tu número. <a href="/premia-2">Ver resultados Premia 2 →</a></p>
        </div>
        <div class="juego-card" style="background:#fff7ed;">
            <h3 style="color:#9a3412;">🌙 La Diaria</h3>
            <p>Análisis del número ganador de La Diaria Honduras. Los datos muestran qué números del 1 al 100 aparecen más frecuentemente a lo largo de los tres sorteos diarios. <a href="/la-diaria">Ver resultados La Diaria →</a></p>
        </div>
        <div class="juego-card" style="background:#fffbeb;">
            <h3 style="color:#b45309;">🏅 Súper Premio</h3>
            <p>Frecuencia de las bolas individuales del Súper Premio Honduras. Analiza cuáles números se extraen más en los sorteos de los miércoles y sábados. <a href="/loto-super-premio">Ver Súper Premio →</a></p>
        </div>
    </div>
</section>

<!-- Cómo usar -->
<section class="seo-section">
    <h2>💡 Cómo Usar las Estadísticas de LotoHN</h2>
    <p>Las estadísticas de LotoHN se actualizan automáticamente después de cada sorteo. Así las podés aprovechar:</p>
    <ul>
        <li><strong>Elegí el juego</strong> en las pestañas (Jugá 3, Pega 3, Premia 2, La Diaria, Súper Premio).</li>
        <li>Revisá la columna de <strong>Números Calientes</strong> para ver los más frecuentes del historial real.</li>
        <li>Compará con los <strong>Números Fríos</strong> para decidir tu estrategia según tu estilo de juego.</li>
        <li>Combiná las estadísticas con el <a href="/historial">historial completo de resultados</a> para análisis más profundos.</li>
        <li>Leé la <a href="/guia/estrategias-loto-honduras">guía de estrategias</a> para sacarle más provecho a estos datos.</li>
    </ul>
</section>

<!-- FAQ visible -->
<section class="seo-section">
    <h2>❓ Preguntas Frecuentes sobre las Estadísticas</h2>
    <div class="faq-item">
        <h3>¿Qué número sale más en Jugá 3 Honduras?</h3>
        <p>Los números calientes de Jugá 3 cambian con el tiempo a medida que se acumulan más sorteos. Consultá la pestaña de Jugá 3 en esta página para ver los más frecuentes según el historial actual. Los datos se actualizan automáticamente después de cada sorteo.</p>
    </div>
    <div class="faq-item">
        <h3>¿Los números calientes tienen más probabilidad de salir?</h3>
        <p>Matemáticamente, no. Cada número tiene exactamente la misma probabilidad en cada sorteo porque los sorteos son eventos independientes. Sin embargo, los números calientes reflejan una tendencia estadística histórica que muchos jugadores consideran al elegir sus números.</p>
    </div>
    <div class="faq-item">
        <h3>¿Cada cuánto se actualizan las estadísticas?</h3>
        <p>Las estadísticas se actualizan con cada carga de la página, tomando los datos más recientes del historial. Después de cada sorteo (11 AM, 3 PM y 9 PM), el historial se actualiza automáticamente y las estadísticas reflejan el nuevo sorteo.</p>
    </div>
    <div class="faq-item">
        <h3>¿Qué número sale más en La Diaria de Honduras?</h3>
        <p>La Diaria tiene números del 1 al 100. En la pestaña de La Diaria de esta página podés ver cuáles han salido más frecuentemente en el historial de todos los sorteos registrados en LotoHN.</p>
    </div>
    <div class="faq-item">
        <h3>¿Puedo ver las estadísticas desde Costa Rica o EE.UU.?</h3>
        <p>Sí, LotoHN y sus estadísticas son completamente gratuitas y accesibles desde Honduras, Costa Rica, Estados Unidos y cualquier país del mundo. Solo necesitás conexión a internet.</p>
    </div>
    <div class="faq-item">
        <h3>¿Las estadísticas incluyen todos los sorteos o solo los recientes?</h3>
        <p>Las estadísticas de LotoHN se calculan sobre el <strong>historial completo</strong> de sorteos almacenados, que incluye meses de resultados de las tres tandas diarias. Cuantos más días acumula el historial, más representativas son las frecuencias.</p>
    </div>
</section>

<!-- Links relacionados -->
<section class="seo-section">
    <h2>🔗 Herramientas Relacionadas</h2>
    <div class="links-grid">
        <a href="/" class="link-card">🏠 Resultados de hoy en vivo</a>
        <a href="/historial" class="link-card">📅 Historial completo</a>
        <a href="/juga-3" class="link-card">🎯 Resultados Jugá 3</a>
        <a href="/pega-3" class="link-card">🎲 Resultados Pega 3</a>
        <a href="/premia-2" class="link-card">🏆 Resultados Premia 2</a>
        <a href="/la-diaria" class="link-card">🌙 Resultados La Diaria</a>
        <a href="/loto-super-premio" class="link-card">🏅 Resultados Súper Premio</a>
        <a href="/signos-la-diaria" class="link-card">♈ Tabla 100 Signos</a>
        <a href="/guia/estrategias-loto-honduras" class="link-card">💡 Guía de Estrategias</a>
        <a href="/guia/probabilidades-loterias-honduras" class="link-card">📊 Probabilidades</a>
        <a href="/guia/loto-honduras-desde-costa-rica" class="link-card">🇨🇷 Loto desde Costa Rica</a>
        <a href="/guia/loto-honduras-desde-estados-unidos" class="link-card">🇺🇸 Loto desde EE.UU.</a>
    </div>
</section>

</div>

<script>
const HISTORIAL_URL = '/api/historial';

const JUEGOS = [
    { key: 'juga3',       label: 'Jugá 3',      color: '#7c3aed', bg: '#f5f3ff' },
    { key: 'pega3',       label: 'Pega 3',       color: '#0369a1', bg: '#f0f9ff' },
    { key: 'premia2',     label: 'Premia 2',     color: '#065f46', bg: '#f0fdf4' },
    { key: 'la_diaria',   label: 'La Diaria',    color: '#9a3412', bg: '#fff7ed' },
    { key: 'super_premio',label: 'Súper Premio', color: '#b45309', bg: '#fffbeb' },
];

const TOP_N = 12;

function detectarJuego(key) {
    if (key.includes('juga3')   || key.includes('juga_3'))   return 'juga3';
    if (key.includes('pega3')   || key.includes('pega_3'))   return 'pega3';
    if (key.includes('premia2') || key.includes('premia_2')) return 'premia2';
    if (key.includes('diaria'))                               return 'la_diaria';
    if (key.includes('super'))                                return 'super_premio';
    return null;
}

function extraerNumeros(datos, juegoKey) {
    // Nuevo formato: datos es array directo; viejo formato: objeto con campos
    const arr = Array.isArray(datos)
        ? datos
        : (datos?.numeros_adicionales?.length ? datos.numeros_adicionales : datos?.numeros_individuales);

    if (!arr?.length) {
        if (datos?.numero_ganador) return [String(datos.numero_ganador).trim()];
        return [];
    }

    if (juegoKey === 'super_premio') {
        // Todas las bolas numéricas (6 por sorteo)
        return arr.map(n => String(n).trim()).filter(n => n && !isNaN(n));
    }

    if (juegoKey === 'la_diaria') {
        // Solo el primer elemento numérico (ignora signo y Más1)
        const num = arr.find(n => !isNaN(String(n).trim()) && String(n).trim() !== '');
        return num ? [String(num).trim()] : [];
    }

    // juga3, pega3, premia2: primer elemento = número ganador
    const first = arr[0];
    return first ? [String(first).trim()] : [];
}

function calcularFrecuencias(historialData) {
    const frecuencias   = {};
    const conteoSorteos = {};
    JUEGOS.forEach(j => { frecuencias[j.key] = {}; conteoSorteos[j.key] = 0; });

    Object.values(historialData).forEach(diaData => {
        Object.entries(diaData).forEach(([key, datos]) => {
            const juego = detectarJuego(key);
            if (!juego || !frecuencias[juego]) return;
            conteoSorteos[juego]++;                        // sorteos reales siempre +1
            const nums = extraerNumeros(datos, juego);
            nums.forEach(n => {
                if (n) frecuencias[juego][n] = (frecuencias[juego][n] || 0) + 1;
            });
        });
    });

    return { frecuencias, conteoSorteos };
}

function renderBarChart(entries, color, maxVal) {
    return entries.map(([num, count]) => {
        const pct = maxVal > 0 ? Math.round((count / maxVal) * 100) : 0;
        return `
            <div class="stat-bar-row">
                <span class="stat-num">${num}</span>
                <div class="stat-bar-wrap">
                    <div class="stat-bar" style="width:${pct}%;background:${color}"></div>
                </div>
                <span class="stat-count">${count}x</span>
            </div>
        `;
    }).join('');
}

function renderEstadisticas(historialData) {
    const loading = document.getElementById('stats-loading');
    const contenido = document.getElementById('stats-contenido');
    if (loading) loading.style.display = 'none';
    if (!contenido) return;

    const { frecuencias, conteoSorteos } = calcularFrecuencias(historialData);
    const totalDias = Object.keys(historialData).length;

    let html = `
    <style>
        .stats-resumen {
            background:#fff;
            border:1px solid #ede9fe;
            border-radius:1rem;
            padding:1rem 1.25rem;
            margin-bottom:1.5rem;
            display:flex;
            gap:1rem;
            flex-wrap:wrap;
            align-items:center;
            box-shadow:0 1px 4px rgba(0,0,0,.06);
        }
        .stats-resumen-item {
            display:flex;
            flex-direction:column;
            align-items:center;
            gap:.15rem;
            min-width:80px;
        }
        .stats-resumen-val {
            font-size:1.5rem;
            font-weight:900;
            color:#7c3aed;
            line-height:1;
        }
        .stats-resumen-lbl {
            font-size:.72rem;
            color:#6b7280;
            font-weight:600;
            text-align:center;
        }
        .stats-tabs {
            display:flex;
            gap:.4rem;
            flex-wrap:nowrap;
            overflow-x:auto;
            padding-bottom:4px;
            margin-bottom:1.25rem;
            scrollbar-width:none;
        }
        .stats-tabs::-webkit-scrollbar { display:none; }
        .stats-tab {
            padding:.4rem 1rem;
            border-radius:9999px;
            font-size:.8rem;
            font-weight:700;
            border:1.5px solid #ede9fe;
            background:#fff;
            color:#7c3aed;
            cursor:pointer;
            white-space:nowrap;
            transition:all .15s;
            -webkit-tap-highlight-color:transparent;
        }
        .stats-tab:hover { background:#f5f3ff; }
        .stats-tab.active { color:#fff; border-color:transparent; }
        .stats-panel { display:none; }
        .stats-panel.active { display:block; }
        .stats-card {
            background:#fff;
            border:1px solid #ede9fe;
            border-radius:1rem;
            overflow:hidden;
            box-shadow:0 1px 4px rgba(0,0,0,.06),0 4px 16px rgba(92,33,182,.06);
            margin-bottom:1.25rem;
        }
        .stats-card-header {
            padding:.85rem 1.25rem;
            font-size:.85rem;
            font-weight:800;
            letter-spacing:.04em;
            text-transform:uppercase;
            display:flex;
            align-items:center;
            gap:.5rem;
        }
        .stats-card-body {
            padding:.75rem 1.25rem 1rem;
        }
        .stat-bar-row {
            display:flex;
            align-items:center;
            gap:.6rem;
            margin-bottom:.55rem;
        }
        .stat-num {
            font-size:.82rem;
            font-weight:800;
            min-width:52px;
            text-align:right;
            font-family:'JetBrains Mono','Fira Mono',ui-monospace,monospace;
            color:#1e1b4b;
        }
        .stat-bar-wrap {
            flex:1;
            height:18px;
            background:#f3f4f6;
            border-radius:9999px;
            overflow:hidden;
        }
        .stat-bar {
            height:100%;
            border-radius:9999px;
            transition:width .4s cubic-bezier(.4,0,.2,1);
            min-width:4px;
        }
        .stat-count {
            font-size:.78rem;
            font-weight:700;
            color:#6b7280;
            min-width:32px;
            text-align:right;
        }
        .stats-two-col {
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:1rem;
        }
        @media (max-width:600px) {
            .stats-two-col { grid-template-columns:1fr; }
        }
        .stats-empty {
            padding:2rem;
            text-align:center;
            color:#9ca3af;
            font-size:.88rem;
        }
        .stats-total-badge {
            background:#f3e8ff;
            color:#7c3aed;
            font-size:.72rem;
            font-weight:700;
            padding:.2rem .6rem;
            border-radius:9999px;
            margin-left:auto;
        }
    </style>

    <div class="stats-resumen">
        <div class="stats-resumen-item">
            <span class="stats-resumen-val">${totalDias}</span>
            <span class="stats-resumen-lbl">Días de historial</span>
        </div>
        ${JUEGOS.map(j => `
            <div class="stats-resumen-item">
                <span class="stats-resumen-val" style="color:${j.color}">${conteoSorteos[j.key]}</span>
                <span class="stats-resumen-lbl">${j.label}<br>sorteos</span>
            </div>`
        ).join('')}
    </div>

    <div class="stats-tabs" id="stats-tabs" role="tablist">
        ${JUEGOS.map((j, i) => `
            <button class="stats-tab${i === 0 ? ' active' : ''}"
                style="${i === 0 ? `background:${j.color}` : ''}"
                data-juego="${j.key}"
                data-color="${j.color}"
                data-bg="${j.bg}"
                role="tab"
                aria-selected="${i === 0}"
                aria-controls="panel-${j.key}">
                ${j.label}
            </button>
        `).join('')}
    </div>
    `;

    JUEGOS.forEach((juego, i) => {
        const freqs   = frecuencias[juego.key];
        const sorted  = Object.entries(freqs).sort((a, b) => b[1] - a[1]);
        const calientes = sorted.slice(0, TOP_N);
        const frios     = sorted.slice(-TOP_N).reverse();
        const maxVal    = calientes.length ? calientes[0][1] : 1;
        const totalSorteos = conteoSorteos[juego.key];

        html += `
        <div class="stats-panel${i === 0 ? ' active' : ''}" id="panel-${juego.key}" role="tabpanel">
            ${sorted.length === 0 ? `<div class="stats-empty">Sin datos suficientes para ${juego.label}.</div>` : `
            <div class="stats-two-col">
                <div class="stats-card">
                    <div class="stats-card-header" style="background:${juego.bg};color:${juego.color}">
                        🔥 Números Calientes
                        <span class="stats-total-badge">${totalSorteos} sorteos</span>
                    </div>
                    <div class="stats-card-body">
                        ${renderBarChart(calientes, juego.color, maxVal)}
                    </div>
                </div>
                <div class="stats-card">
                    <div class="stats-card-header" style="background:#f9fafb;color:#374151">
                        🧊 Números Fríos
                        <span class="stats-total-badge">${sorted.length} distintos</span>
                    </div>
                    <div class="stats-card-body">
                        ${renderBarChart(frios, '#9ca3af', frios.length ? frios[0][1] : 1)}
                    </div>
                </div>
            </div>
            `}
        </div>`;
    });

    contenido.innerHTML = html;

    document.getElementById('stats-tabs').addEventListener('click', e => {
        const btn = e.target.closest('.stats-tab');
        if (!btn) return;
        const juego = btn.dataset.juego;
        const color = btn.dataset.color;

        document.querySelectorAll('.stats-tab').forEach(b => {
            b.classList.remove('active');
            b.style.background = '';
        });
        btn.classList.add('active');
        btn.style.background = color;

        document.querySelectorAll('.stats-panel').forEach(p => p.classList.remove('active'));
        document.getElementById(`panel-${juego}`)?.classList.add('active');
    });
}

async function cargarEstadisticas() {
    try {
        const resp = await fetch('/api/historial', { cache: 'no-cache' });
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const data = await resp.json();
        renderEstadisticas(data);
    } catch (err) {
        const loading = document.getElementById('stats-loading');
        const contenido = document.getElementById('stats-contenido');
        if (loading) loading.style.display = 'none';
        if (contenido) contenido.innerHTML = `
            <div style="text-align:center;padding:2.5rem;color:#dc2626;font-size:.9rem;">
                <div style="font-size:2rem;margin-bottom:.75rem;">⚠️</div>
                No se pudieron cargar los datos.<br>
                <small style="color:#9ca3af;">${err.message}</small>
            </div>`;
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', cargarEstadisticas);
} else {
    cargarEstadisticas();
}
</script>
    <CoberturaPaises tema="las estadísticas de Loto Honduras" />
</Layout>
