---
// src/components/AnalizadorIA.astro
---

<div id="analizador-root" class="analizador-root" aria-label="Analizador IA">

    <!-- Skeleton -->
    <div class="an-skeleton" id="an-skeleton">
        <div class="sk-toprow">
            <div class="sk-dot"></div>
            <div class="sk-line" style="width:38%"></div>
            <div class="sk-pill"></div>
        </div>
        <div class="sk-tabs">
            <div class="sk-tab"></div>
            <div class="sk-tab" style="animation-delay:.1s"></div>
            <div class="sk-tab" style="animation-delay:.2s"></div>
            <div class="sk-tab" style="animation-delay:.3s"></div>
            <div class="sk-tab" style="animation-delay:.4s"></div>
        </div>
        <div class="sk-line" style="width:92%;margin-top:.9rem"></div>
        <div class="sk-line" style="width:70%;margin-top:.45rem"></div>
        <div class="sk-line" style="width:55%;margin-top:.45rem"></div>
    </div>

    <!-- Card -->
    <div class="an-card" id="an-card" style="display:none">

        <div class="an-header">
            <div class="an-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.4"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                    <path d="M2 17l10 5 10-5"/>
                    <path d="M2 12l10 5 10-5"/>
                </svg>
            </div>
            <div class="an-meta">
                <span class="an-label">Analizador IA</span>
                <span class="an-fecha" id="an-fecha"></span>
            </div>
            <div class="an-badge">🤖 IA</div>
        </div>

        <!-- Tabs de juegos -->
        <div class="an-tabs" id="an-tabs" role="tablist"></div>

        <!-- Panel del juego activo -->
        <div class="an-panel" id="an-panel">
            <p class="an-texto" id="an-patrones"></p>
            <p class="an-texto an-tendencias" id="an-tendencias"></p>
            <div class="an-sugs" id="an-sugs" style="display:none">
                <span class="an-sugs-label">🎯 Sugerencias</span>
                <div class="an-balls-row" id="an-balls"></div>
            </div>
        </div>

        <!-- Botón -->
        <div class="an-bottom">
            <button class="an-btn" id="an-btn" type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
                Ver sugerencias de hoy
            </button>
        </div>

    </div>

    <!-- Error -->
    <div class="an-error" id="an-error" style="display:none">
        🤖 El análisis no está disponible ahora. Volvé más tarde.
    </div>
</div>

<style>
    .analizador-root {
        --ca:     #7c3aed;
        --cb:     #ddd6fe;
        --ca-rgb: 124,58,237;
        font-family: inherit;
        width: 100%;
    }

    .an-skeleton {
        background: #fff;
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 1rem;
        padding: .9rem 1.2rem 1rem;
    }
    .sk-toprow { display:flex; align-items:center; gap:.55rem; }
    .sk-dot  { width:1.6rem; height:1.6rem; border-radius:50%;
               background:rgba(0,0,0,.08); flex-shrink:0;
               animation:sk-s 1.5s ease-in-out infinite; }
    .sk-pill { width:3rem; height:1rem; border-radius:2rem;
               background:rgba(0,0,0,.08); margin-left:auto;
               animation:sk-s 1.5s ease-in-out infinite; }
    .sk-line { height:.56rem; border-radius:.4rem;
               background:linear-gradient(90deg,rgba(0,0,0,.05) 25%,rgba(0,0,0,.1) 50%,rgba(0,0,0,.05) 75%);
               background-size:200% 100%; animation:sk-s 1.5s ease-in-out infinite; }
    .sk-tabs { display:flex; gap:.5rem; margin-top:.9rem; }
    .sk-tab  { height:1.8rem; width:5rem; border-radius:.5rem;
               background:rgba(0,0,0,.07); animation:sk-s 1.5s ease-in-out infinite; }
    @keyframes sk-s {
        0%,100% { background-position:200% center; opacity:.7; }
        50%      { opacity:1; }
    }

    .an-card {
        background: #fff;
        border: 1px solid rgba(0,0,0,.09);
        border-radius: 1rem;
        overflow: hidden;
        position: relative;
        box-shadow: inset 0 3px 0 var(--ca), 0 2px 8px rgba(0,0,0,.07);
        animation: an-in .4s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes an-in {
        from { opacity:0; transform:translateY(6px); }
        to   { opacity:1; transform:translateY(0); }
    }
    .an-card::before {
        content:''; position:absolute; inset:0;
        background:linear-gradient(160deg, rgba(var(--ca-rgb),.05) 0%, transparent 50%);
        pointer-events:none; z-index:0;
    }

    .an-header {
        display:flex; align-items:center; gap:.55rem;
        padding:.8rem 1.2rem .5rem;
        position:relative; z-index:1;
    }
    .an-icon {
        width:1.7rem; height:1.7rem; border-radius:50%;
        background:rgba(var(--ca-rgb),.15); color:var(--ca);
        display:flex; align-items:center; justify-content:center; flex-shrink:0;
    }
    .an-meta { display:flex; flex-direction:column; gap:.05rem; flex:1; min-width:0; }
    .an-label {
        font-size:.67rem; font-weight:800; text-transform:uppercase;
        letter-spacing:.07em; color:var(--ca); line-height:1;
    }
    .an-fecha { font-size:.6rem; color:#9ca3af; font-weight:500; }
    .an-badge {
        font-size:.6rem; font-weight:700; color:var(--ca);
        background:rgba(var(--ca-rgb),.1); border:1px solid rgba(var(--ca-rgb),.25);
        padding:.2rem .6rem; border-radius:2rem; white-space:nowrap; flex-shrink:0;
    }

    .an-tabs {
        display:flex; gap:.4rem; flex-wrap:wrap;
        padding:.35rem 1.2rem .55rem;
        position:relative; z-index:1;
        border-bottom:1px solid rgba(0,0,0,.06);
    }

    .an-panel {
        padding:.75rem 1.2rem .5rem;
        position:relative; z-index:1;
        animation: an-fade .25s ease both;
    }
    @keyframes an-fade { from{opacity:0;} to{opacity:1;} }

    .an-texto {
        font-size:.82rem; color:#374151; line-height:1.6; margin:0 0 .35rem;
    }
    .an-tendencias { color:#6b7280; font-style:italic; }

    .an-sugs { margin-top:.65rem; }
    .an-sugs-label {
        font-size:.57rem; font-weight:700; text-transform:uppercase;
        letter-spacing:.07em; color:var(--ca); display:block; margin-bottom:.45rem;
    }
    .an-balls-row { display:flex; gap:.4rem; flex-wrap:wrap; }

    .an-bottom {
        padding:.55rem 1.2rem .85rem;
        position:relative; z-index:1;
    }
    .an-btn {
        display:inline-flex; align-items:center; gap:.45rem;
        background:linear-gradient(135deg, var(--ca), #a855f7);
        color:#fff; font-size:.8rem; font-weight:700;
        padding:.5rem 1.15rem; border-radius:2rem; border:none; cursor:pointer;
        box-shadow:0 3px 10px rgba(var(--ca-rgb),.35);
        transition:transform .15s ease, box-shadow .15s ease;
    }
    .an-btn:hover { transform:translateY(-2px); box-shadow:0 6px 18px rgba(var(--ca-rgb),.4); }
    .an-btn:active { transform:translateY(0); }
    .an-btn.done {
        background:linear-gradient(135deg,#16a34a,#22c55e);
        box-shadow:0 3px 10px rgba(22,163,74,.35);
        cursor:default; pointer-events:none;
    }

    .an-error {
        font-size:.8rem; color:#9ca3af; padding:.8rem 1rem;
        border:1px dashed rgba(0,0,0,.1); border-radius:1rem; text-align:center;
    }
</style>

<style is:global>
    #analizador-root .an-tab-btn {
        font-size:.7rem; font-weight:700; text-transform:uppercase;
        letter-spacing:.04em; padding:.3rem .75rem; border-radius:.5rem;
        border:1px solid rgba(124,58,237,.22); background:transparent;
        color:#6b7280; cursor:pointer;
        transition:background .15s, color .15s;
    }
    #analizador-root .an-tab-btn:hover {
        background:rgba(124,58,237,.08); color:#7c3aed;
    }
    #analizador-root .an-tab-btn.active {
        background:rgba(124,58,237,.12); color:#7c3aed;
        border-color:rgba(124,58,237,.45); font-weight:800;
    }

    #analizador-root .an-ball {
        width:2.4rem; height:2.4rem; border-radius:50%;
        display:flex; align-items:center; justify-content:center;
        font-size:.88rem; font-weight:900; color:#fff;
        background: radial-gradient(circle at 33% 28%, #fff 0%, #ddd6fe 28%, #7c3aed 62%, rgba(0,0,0,.28) 100%);
        box-shadow: 0 3px 8px rgba(124,58,237,.35), inset 0 -2px 5px rgba(0,0,0,.2), inset 0 2px 4px rgba(255,255,255,.4);
        flex-shrink:0;
        animation: an-ball-in .4s cubic-bezier(.34,1.56,.64,1) both;
    }
    @keyframes an-ball-in {
        from { opacity:0; transform:scale(.3); }
        to   { opacity:1; transform:scale(1); }
    }
</style>

<script>
(async () => {
    const skeleton   = document.getElementById('an-skeleton')   as HTMLElement;
    const card       = document.getElementById('an-card')       as HTMLElement;
    const errorEl    = document.getElementById('an-error')      as HTMLElement;
    const tabsEl     = document.getElementById('an-tabs')       as HTMLElement;
    const patronesEl = document.getElementById('an-patrones')   as HTMLElement;
    const tendEl     = document.getElementById('an-tendencias') as HTMLElement;
    const sugsEl     = document.getElementById('an-sugs')       as HTMLElement;
    const ballsEl    = document.getElementById('an-balls')      as HTMLElement;
    const btn        = document.getElementById('an-btn')        as HTMLButtonElement;
    const panelEl    = document.getElementById('an-panel')      as HTMLElement;

    const LABELS: Record<string, string> = {
        juga3: 'Jugá 3', pega_3: 'Pega 3', premia2: 'Premia 2',
        la_diaria: 'La Diaria', super_premio: 'Súper Premio'
    };

    let juegosData: Record<string, any> = {};
    let activeKey = '';
    let revealed = false;

    function renderBolas(nums: (number|string)[]) {
        ballsEl.innerHTML = '';
        nums.forEach((n, i) => {
            const b = document.createElement('div');
            b.className = 'an-ball';
            b.textContent = String(n);
            b.style.animationDelay = `${i * 0.08}s`;
            ballsEl.appendChild(b);
        });
        sugsEl.style.display = nums.length ? 'block' : 'none';
    }

    function renderPanel(key: string, mostrarSugs: boolean) {
        const d = juegosData[key];
        if (!d) return;

        panelEl.style.animation = 'none';
        void panelEl.offsetWidth;
        panelEl.style.animation = '';

        patronesEl.textContent = d.patrones  || '';
        tendEl.textContent     = d.tendencias || '';

        if (mostrarSugs) {
            renderBolas((d.sugerencias || []) as (number|string)[]);
        } else {
            sugsEl.style.display = 'none';
        }
    }

    function activarTab(key: string) {
        activeKey = key;
        tabsEl.querySelectorAll<HTMLButtonElement>('.an-tab-btn').forEach(b => {
            b.classList.toggle('active', b.dataset.key === key);
        });
        renderPanel(key, revealed);
    }

    try {
        const resp = await fetch('/api/analizar', { cache: 'no-store' });
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const data = await resp.json();
        if (!data?.juegos) throw new Error('Sin datos');

        juegosData = data.juegos;

        // Fecha
        if (data.fecha) {
            const [y, m, d] = (data.fecha as string).split('-').map(Number);
            const dias  = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
            const meses = ['Enero','Febrero','Marzo','Abril','Mayo','Junio',
                           'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
            const f = new Date(y, m - 1, d);
            (document.getElementById('an-fecha') as HTMLElement).textContent =
                `${dias[f.getDay()]} ${d} de ${meses[m-1]}`;
        }

        // Tabs
        Object.keys(juegosData).forEach(key => {
            const b = document.createElement('button');
            b.className = 'an-tab-btn';
            b.dataset.key = key;
            b.textContent = LABELS[key] || key;
            b.setAttribute('role', 'tab');
            b.addEventListener('click', () => activarTab(key));
            tabsEl.appendChild(b);
        });

        const keys = Object.keys(juegosData);
        if (keys.length) activarTab(keys[0]);

        // Botón
        btn.addEventListener('click', () => {
            window.open('https://omg10.com/4/11134766', '_blank', 'noopener,noreferrer');
            if (!revealed) {
                revealed = true;
                btn.textContent = '✓ Sugerencias reveladas';
                btn.classList.add('done');
                renderPanel(activeKey, true);
            }
        });

        skeleton.style.display = 'none';
        card.style.display     = 'block';

    } catch (e) {
        console.warn('AnalizadorIA:', (e as Error).message);
        skeleton.style.display = 'none';
        errorEl.style.display  = 'block';
    }
})();
</script>
