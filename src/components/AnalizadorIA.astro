---
// src/components/AnalizadorIA.astro
//
// Banner de análisis del día. Cambió de fondo respecto a la versión anterior:
//
//  - Se pinta en el build, como los resultados. Antes salía un skeleton y el
//    contenido aparecía al terminar el fetch, con su salto de layout; ahora el
//    HTML ya llega escrito y el navegador sólo lo pone al día.
//  - El HTML lo genera `src/lib/analisis.js`, que usan build y cliente, así que
//    las dos pinturas no pueden divergir.
//  - Las sugerencias se leen bien: "11-58-88" son tres esferas de una misma
//    combinación, y tres sugerencias sueltas son tres filas. Antes Pega 3
//    mostraba una píldora con el texto "11-58-88" dentro y Jugá 3 juntaba tres
//    sugerencias distintas en una sola fila, como si fueran una combinación.
//  - El desbloqueo se recuerda durante la visita. Antes se reseteaba en cada
//    cambio de pestaña, así que había que pulsarlo cinco veces seguidas.
import { obtenerAnalisis } from '../lib/datos-build.js';
import { normalizarAnalisis, analizadorHTML, firmaAnalisis } from '../lib/analisis.js';

const crudo  = await obtenerAnalisis();
const datos  = crudo ? normalizarAnalisis(crudo) : null;
const cuerpo = datos ? analizadorHTML(datos) : '';
const firma  = datos ? firmaAnalisis(datos) : '';
---

<section
    id="analizador-root"
    class="an-root"
    aria-label="Analizador de números"
    data-revelado="false"
    data-firma={firma}
>
    {cuerpo ? (
        <div class="an-cuerpo" set:html={cuerpo} />
    ) : (
        <div class="an-cuerpo an-cargando" aria-busy="true">
            <div class="an-sk an-sk-tit"></div>
            <div class="an-sk an-sk-sub"></div>
            <div class="an-sk-tabs">
                <div class="an-sk an-sk-tab"></div>
                <div class="an-sk an-sk-tab"></div>
                <div class="an-sk an-sk-tab"></div>
            </div>
            <div class="an-sk an-sk-linea"></div>
            <div class="an-sk an-sk-linea corta"></div>
        </div>
    )}

    <p class="an-error" hidden>El análisis no está disponible en este momento. Volvé más tarde.</p>
</section>

<style is:global>
    /* ============================================
       ANALIZADOR — contenedor
       ============================================ */
    .an-root {
        --an-oro: #fbbf24;
        --an-tinta: #1e1b4b;
        position: relative;
        display: block;
        border-radius: 1.25rem;
        overflow: hidden;
        color: #fff;
        background:
            radial-gradient(90% 120% at 100% 0%, rgba(168, 85, 247, 0.45), transparent 60%),
            radial-gradient(70% 100% at 0% 100%, rgba(6, 182, 212, 0.25), transparent 55%),
            linear-gradient(135deg, #1e1b4b 0%, #4c1d95 55%, #5b21b6 100%);
        box-shadow: 0 10px 30px rgba(76, 29, 149, 0.28);
    }
    /* Filo superior: el mismo recurso que usan las tarjetas de sorteo. */
    .an-root::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 3px;
        background: linear-gradient(90deg, var(--an-oro), #f472b6 45%, #22d3ee);
    }
    .an-root * { box-sizing: border-box; }
    .an-ico { width: 1rem; height: 1rem; flex-shrink: 0; }

    .an-cuerpo { padding: 1.15rem 1.35rem 1.35rem; }

    /* ============================================
       Cabecera
       ============================================ */
    .an-cabecera { display: flex; align-items: center; gap: 0.7rem; }
    .an-marca {
        display: grid;
        place-items: center;
        width: 2.35rem;
        height: 2.35rem;
        flex-shrink: 0;
        border-radius: 0.75rem;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: var(--an-oro);
    }
    .an-ico-marca { width: 1.15rem; height: 1.15rem; }
    .an-titulo {
        margin: 0;
        font-size: 1.02rem;
        font-weight: 800;
        letter-spacing: 0.01em;
        color: #fff;
        line-height: 1.25;
    }
    .an-sub {
        margin: 0.1rem 0 0;
        font-size: 0.74rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.62);
    }

    /* ============================================
       Pestañas
       ============================================ */
    .an-tabs {
        display: flex;
        gap: 0.3rem;
        margin: 0.95rem 0 0.8rem;
        padding: 0.25rem;
        border-radius: 0.8rem;
        background: rgba(0, 0, 0, 0.22);
        overflow-x: auto;
        scrollbar-width: none;
    }
    .an-tabs::-webkit-scrollbar { display: none; }
    .an-tab {
        flex: 1 0 auto;
        white-space: nowrap;
        padding: 0.42rem 0.85rem;
        border: none;
        border-radius: 0.6rem;
        background: transparent;
        color: rgba(255, 255, 255, 0.66);
        font: inherit;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.18s ease, color 0.18s ease;
    }
    .an-tab:hover { background: rgba(255, 255, 255, 0.09); color: #fff; }
    .an-tab[aria-selected="true"] {
        background: rgba(255, 255, 255, 0.95);
        color: var(--an-tinta);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.22);
    }
    .an-root :is(.an-tab, .an-btn):focus-visible {
        outline: 2px solid var(--an-oro);
        outline-offset: 2px;
    }

    /* ============================================
       Panel
       ============================================ */
    .an-panel {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
        gap: 1.1rem;
        align-items: start;
    }
    .an-panel[hidden] { display: none !important; }
    .an-panel:focus-visible { outline: none; }

    .an-lecturas { display: flex; flex-direction: column; gap: 0.7rem; min-width: 0; }
    .an-lectura { display: flex; gap: 0.55rem; align-items: flex-start; }
    .an-lectura-ico {
        display: grid;
        place-items: center;
        width: 1.55rem;
        height: 1.55rem;
        flex-shrink: 0;
        border-radius: 0.5rem;
        background: rgba(255, 255, 255, 0.1);
        color: var(--an-oro);
    }
    .an-lectura-tit {
        margin: 0 0 0.12rem;
        font-size: 0.66rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: rgba(255, 255, 255, 0.55);
    }
    .an-lectura-txt {
        margin: 0;
        font-size: 0.85rem;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.92);
    }
    .an-muestra {
        margin: 0.1rem 0 0;
        font-size: 0.68rem;
        color: rgba(255, 255, 255, 0.45);
    }

    /* ============================================
       Sugerencias
       ============================================ */
    .an-sugerencias {
        min-width: 0;
        padding: 0.85rem 0.9rem;
        border-radius: 0.9rem;
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .an-sug-tit {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin: 0 0 0.6rem;
        font-size: 0.64rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--an-oro);
    }
    .an-sug-caja { position: relative; }
    .an-sug-lista {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        transition: filter 0.3s ease, opacity 0.3s ease;
    }
    .an-sug { display: flex; align-items: center; gap: 0.5rem; }
    .an-sug-n {
        flex-shrink: 0;
        width: 1.05rem;
        font-size: 0.62rem;
        font-weight: 800;
        color: rgba(255, 255, 255, 0.35);
        font-variant-numeric: tabular-nums;
    }
    .an-esferas { display: flex; flex-wrap: wrap; gap: 0.3rem; }
    .an-esfera {
        display: grid;
        place-items: center;
        min-width: 2.1rem;
        height: 2.1rem;
        padding: 0 0.45rem;
        border-radius: 50%;
        font-size: 0.82rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        color: var(--an-tinta);
        background: radial-gradient(circle at 34% 28%, #fff 0%, #fde68a 38%, #f59e0b 72%, #b45309 100%);
        box-shadow: 0 3px 8px rgba(245, 158, 11, 0.45), inset 0 -2px 4px rgba(0, 0, 0, 0.16);
        animation: an-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
    .an-esfera.texto {
        border-radius: 1.05rem;
        font-size: 0.72rem;
        color: #fff;
        background: linear-gradient(135deg, #8b5cf6, #5b21b6);
        box-shadow: 0 3px 8px rgba(124, 58, 237, 0.45);
    }
    @keyframes an-pop {
        from { opacity: 0; transform: scale(0.4); }
        to   { opacity: 1; transform: scale(1); }
    }
    .an-sin-sugerencias {
        margin: 0;
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.55);
        font-style: italic;
    }

    /* Candado: las combinaciones están en la página, veladas hasta que se pide
       verlas. Una sola vez por visita — no una por pestaña, como antes. */
    .an-root:not([data-revelado="true"]) .an-sug-lista {
        filter: blur(7px);
        opacity: 0.6;
        pointer-events: none;
        user-select: none;
    }
    .an-root[data-revelado="true"] .an-candado { display: none; }
    .an-candado {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        text-align: center;
    }
    .an-candado-txt {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        margin: 0;
        font-size: 0.68rem;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.72);
    }
    .an-btn {
        border: none;
        border-radius: 2rem;
        padding: 0.45rem 1.05rem;
        font: inherit;
        font-size: 0.76rem;
        font-weight: 800;
        color: var(--an-tinta);
        background: linear-gradient(135deg, #fcd34d, #f59e0b);
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4);
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .an-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(245, 158, 11, 0.55); }
    .an-btn:active { transform: translateY(0); }

    /* ============================================
       Aviso y errores
       ============================================ */
    .an-aviso {
        display: flex;
        align-items: flex-start;
        gap: 0.4rem;
        margin: 0.9rem 0 0;
        padding-top: 0.7rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 0.68rem;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.5);
    }
    .an-aviso .an-ico { margin-top: 0.1rem; }
    .an-error {
        margin: 0;
        padding: 1.1rem 1.35rem;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.7);
        text-align: center;
    }

    /* ============================================
       Skeleton (sólo si el build no pudo leer la API)
       ============================================ */
    .an-sk { border-radius: 0.4rem; background: rgba(255, 255, 255, 0.12); animation: an-latido 1.5s ease-in-out infinite; }
    .an-sk-tit   { height: 0.95rem; width: 11rem; }
    .an-sk-sub   { height: 0.6rem;  width: 7rem;  margin-top: 0.45rem; }
    .an-sk-tabs  { display: flex; gap: 0.4rem; margin: 0.9rem 0; }
    .an-sk-tab   { height: 1.8rem; width: 5.5rem; }
    .an-sk-linea { height: 0.6rem; width: 100%; margin-top: 0.5rem; }
    .an-sk-linea.corta { width: 62%; }
    @keyframes an-latido { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }

    /* ============================================
       Responsive
       ============================================ */
    @media (max-width: 860px) {
        .an-panel { grid-template-columns: minmax(0, 1fr); }
    }
    @media (max-width: 520px) {
        .an-cuerpo { padding: 1rem 0.9rem 1.1rem; }
        .an-titulo { font-size: 0.95rem; }
        .an-tab { font-size: 0.72rem; padding: 0.38rem 0.7rem; }
        .an-esfera { min-width: 1.95rem; height: 1.95rem; font-size: 0.78rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        .an-root :is(.an-esfera, .an-sk, .an-btn) {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<script>
import { fetchJSON } from '../scripts/api.js';
import { normalizarAnalisis, analizadorHTML, firmaAnalisis } from '../lib/analisis.js';

(() => {
    const raiz = document.getElementById('analizador-root');
    if (!raiz) return;

    const cuerpo = raiz.querySelector('.an-cuerpo') as HTMLElement | null;
    const errorEl = raiz.querySelector('.an-error') as HTMLElement | null;
    if (!cuerpo) return;

    const CLAVE_REVELADO = 'lotohn.analisis.revelado';
    const REFRESCO_MS = 5 * 60 * 1000;

    let ultimaLectura = 0;
    let pidiendo = false;

    // ============================================
    // Desbloqueo — recordado durante la visita
    // ============================================

    function leerRevelado(): boolean {
        try { return sessionStorage.getItem(CLAVE_REVELADO) === '1'; } catch { return false; }
    }

    function revelar() {
        raiz.dataset.revelado = 'true';
        try { sessionStorage.setItem(CLAVE_REVELADO, '1'); } catch { /* modo privado */ }
    }

    if (leerRevelado()) raiz.dataset.revelado = 'true';

    // ============================================
    // Pestañas — accesibles de verdad
    // ============================================

    function tabs(): HTMLButtonElement[] {
        return Array.from(raiz.querySelectorAll<HTMLButtonElement>('.an-tab'));
    }

    function activar(id: string, mover = false) {
        for (const tab of tabs()) {
            const activo = tab.dataset.id === id;
            tab.setAttribute('aria-selected', String(activo));
            tab.tabIndex = activo ? 0 : -1;
            if (!activo) continue;
            if (mover) tab.focus();
            // En móvil la tira de pestañas se desplaza: que la elegida quede a
            // la vista. `nearest` no mueve nada si ya se veía entera.
            tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
        raiz.querySelectorAll<HTMLElement>('.an-panel').forEach(panel => {
            panel.hidden = panel.id !== `an-panel-${id}`;
        });
    }

    function idActivo(): string {
        const actual = raiz.querySelector<HTMLButtonElement>('.an-tab[aria-selected="true"]');
        return actual?.dataset.id || tabs()[0]?.dataset.id || '';
    }

    // Delegación: los botones se rehacen en cada repintado, así que los
    // escuchadores viven en la raíz y no hay que volver a engancharlos.
    raiz.addEventListener('click', (e) => {
        const destino = e.target as HTMLElement;
        const tab = destino.closest<HTMLButtonElement>('.an-tab');
        if (tab?.dataset.id) { activar(tab.dataset.id); return; }
        if (destino.closest('[data-accion="revelar"]')) revelar();
    });

    raiz.addEventListener('keydown', (e) => {
        const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('.an-tab');
        if (!tab) return;
        const lista = tabs();
        const i = lista.indexOf(tab);
        let siguiente = -1;

        if (e.key === 'ArrowRight') siguiente = (i + 1) % lista.length;
        else if (e.key === 'ArrowLeft') siguiente = (i - 1 + lista.length) % lista.length;
        else if (e.key === 'Home') siguiente = 0;
        else if (e.key === 'End') siguiente = lista.length - 1;
        else return;

        e.preventDefault();
        const id = lista[siguiente]?.dataset.id;
        if (id) activar(id, true);
    });

    // ============================================
    // Datos
    // ============================================

    function pintar(json: unknown) {
        const datos = normalizarAnalisis(json);
        if (datos.juegos.length === 0) throw new Error('sin juegos');

        const firma = firmaAnalisis(datos);
        // Mismo análisis que el del build: no se toca el DOM. Repintar por
        // repintar reiniciaría las animaciones de las esferas cada cinco
        // minutos sin que hubiera cambiado nada.
        if (firma && firma === raiz.dataset.firma) return;

        cuerpo.innerHTML = analizadorHTML(datos, { activo: idActivo() });
        cuerpo.classList.remove('an-cargando');
        cuerpo.removeAttribute('aria-busy');
        raiz.dataset.firma = firma;
        if (errorEl) errorEl.hidden = true;
    }

    async function cargar() {
        if (pidiendo) return;
        pidiendo = true;
        try {
            pintar(await fetchJSON('/api/analizar'));
        } catch (e) {
            console.warn('AnalizadorIA:', (e as Error).message);
            // Con el análisis del build en pantalla, un fallo de red no borra
            // nada: sólo se avisa cuando no hay absolutamente nada que mostrar.
            if (!raiz.querySelector('.an-panel')) {
                cuerpo.hidden = true;
                if (errorEl) errorEl.hidden = false;
            }
        } finally {
            pidiendo = false;
            ultimaLectura = Date.now();
        }
    }

    function refrescarSiHaceFalta() {
        if (document.visibilityState !== 'visible') return;
        if (Date.now() - ultimaLectura < REFRESCO_MS) return;
        cargar();
    }

    // El análisis envejece con los sorteos: `main.js` avisa cada vez que trae
    // resultados y este banner se pone al día en la misma tanda.
    document.addEventListener('lotohn:resultados', refrescarSiHaceFalta);
    document.addEventListener('visibilitychange', refrescarSiHaceFalta);

    // Sin contenido del build hay que pedirlo ya; con contenido, la primera
    // petición puede esperar a que la página termine de cargar.
    if (raiz.querySelector('.an-panel')) {
        activar(idActivo());
        ultimaLectura = Date.now();
    } else {
        cargar();
    }
})();
</script>
