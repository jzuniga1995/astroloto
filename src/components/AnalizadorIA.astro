---
// src/components/AnalizadorIA.astro
---

<div id="analizador-root" aria-label="Analizador IA">

    <!-- Skeleton -->
    <div class="an-skeleton" id="an-skeleton">
        <div class="sk-inner">
            <div class="sk-left">
                <div class="sk-title"></div>
                <div class="sk-sub"></div>
            </div>
            <div class="sk-tabs">
                <div class="sk-tab"></div><div class="sk-tab"></div>
                <div class="sk-tab"></div><div class="sk-tab"></div>
            </div>
            <div class="sk-body">
                <div class="sk-line w90"></div>
                <div class="sk-line w70"></div>
                <div class="sk-line w55"></div>
            </div>
        </div>
    </div>

    <!-- Banner principal -->
    <div class="an-banner" id="an-card" style="display:none">

        <div class="an-bg-orbs" aria-hidden="true">
            <div class="orb orb1"></div>
            <div class="orb orb2"></div>
            <div class="orb orb3"></div>
        </div>

        <!-- Header -->
        <div class="an-top">
            <div class="an-brand">
                <span class="an-fire">🔥</span>
                <div>
                    <div class="an-title">Analizador IA</div>
                    <div class="an-subtitle" id="an-fecha">Cargando...</div>
                </div>
            </div>
            <div class="an-badges">
                <span class="badge-ai">🤖 Powered by IA</span>
                <span class="badge-live">⚡ En vivo</span>
            </div>
        </div>

        <!-- Tabs -->
        <div class="an-tabs" id="an-tabs" role="tablist"></div>

        <!-- Panel -->
        <div class="an-panel" id="an-panel">
            <!-- Estado bloqueado: teaser sin números -->
            <div class="an-teaser" id="an-teaser">
                <span class="teaser-icon">🔒</span>
                <p class="teaser-txt">El análisis completo con patrones, tendencias y sugerencias está listo.<br>Hacé clic en el botón para desbloquearlo.</p>
            </div>
            <!-- Contenido real: solo visible tras ver el anuncio -->
            <div class="an-cols" id="an-cols" style="display:none">
                <div class="an-col-text">
                    <div class="an-text-block">
                        <span class="block-icon">📊</span>
                        <p id="an-patrones"></p>
                    </div>
                    <div class="an-text-block">
                        <span class="block-icon">📈</span>
                        <p id="an-tendencias"></p>
                    </div>
                </div>
                <div class="an-col-sugs" id="an-sugs" style="display:none">
                    <div class="sugs-header">🎯 Sugerencias del día</div>
                    <div id="an-combos-wrap"></div>
                    <div class="sugs-disclaimer" id="an-advertencia"></div>
                </div>
            </div>
        </div>

        <!-- CTA -->
        <div class="an-cta" id="an-cta">
            <!-- Estado bloqueado (default) -->
            <div class="an-locked" id="an-locked">
                <button class="an-btn" id="an-btn" type="button">
                    🎰 Ver sugerencias de hoy
                </button>
                <span class="an-cta-hint">Análisis gratuito actualizado cada día</span>
            </div>
            <!-- Estado revelado -->
            <div class="an-revealed-msg" id="an-revealed-msg" style="display:none">
                <span class="an-revealed-tag">✅ Sugerencias reveladas</span>
                <span class="an-cta-hint">Cambiá de juego para ver más análisis</span>
            </div>
        </div>

    </div>

    <!-- Error -->
    <div class="an-error" id="an-error" style="display:none">
        🤖 El análisis no está disponible ahora. Volvé más tarde.
    </div>
</div>

<style>
    #analizador-root * { box-sizing: border-box; }
    #analizador-root { width: 100%; font-family: inherit; }

    /* Skeleton */
    .an-skeleton {
        border-radius: 1.25rem;
        background: linear-gradient(135deg, #1e1b4b, #4c1d95);
        padding: 1.25rem 1.5rem;
    }
    .sk-inner { display:flex; flex-direction:column; gap:.75rem; }
    .sk-left  { display:flex; flex-direction:column; gap:.4rem; }
    .sk-title { height:.9rem; width:8rem; border-radius:.4rem; background:rgba(255,255,255,.15); animation:skp 1.5s ease-in-out infinite; }
    .sk-sub   { height:.6rem; width:5rem; border-radius:.4rem; background:rgba(255,255,255,.1);  animation:skp 1.5s ease-in-out infinite .1s; }
    .sk-tabs  { display:flex; gap:.5rem; }
    .sk-tab   { height:1.7rem; width:5.5rem; border-radius:.5rem; background:rgba(255,255,255,.1); animation:skp 1.5s ease-in-out infinite; }
    .sk-body  { display:flex; flex-direction:column; gap:.35rem; }
    .sk-line  { height:.55rem; border-radius:.3rem; background:rgba(255,255,255,.1); animation:skp 1.5s ease-in-out infinite; }
    .w90{width:90%} .w70{width:70%} .w55{width:55%}
    @keyframes skp { 0%,100%{opacity:.5} 50%{opacity:1} }

    /* Banner */
    .an-banner {
        border-radius: 1.25rem;
        background: linear-gradient(135deg, #1e1b4b 0%, #4c1d95 45%, #6d28d9 100%);
        overflow: hidden;
        position: relative;
        box-shadow: 0 8px 32px rgba(109,40,217,.45), 0 2px 8px rgba(0,0,0,.2);
        animation: ban-in .5s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes ban-in {
        from { opacity:0; transform:translateY(8px) scale(.99); }
        to   { opacity:1; transform:translateY(0)   scale(1); }
    }

    .an-bg-orbs { position:absolute; inset:0; pointer-events:none; overflow:hidden; z-index:0; }
    .orb { position:absolute; border-radius:50%; filter:blur(40px); opacity:.35; }
    .orb1 { width:220px; height:220px; background:#a855f7; top:-60px; right:-40px; }
    .orb2 { width:160px; height:160px; background:#f59e0b; bottom:-50px; left:10%; }
    .orb3 { width:120px; height:120px; background:#06b6d4; top:30%; right:25%; }

    .an-top {
        display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.75rem;
        padding:1rem 1.4rem .6rem; position:relative; z-index:1;
    }
    .an-brand { display:flex; align-items:center; gap:.65rem; }
    .an-fire  { font-size:2rem; line-height:1; filter:drop-shadow(0 0 8px rgba(251,146,60,.8)); animation:fire-flicker 2s ease-in-out infinite; }
    @keyframes fire-flicker {
        0%,100% { transform:scale(1)   rotate(-2deg); }
        50%      { transform:scale(1.1) rotate(2deg);  }
    }
    .an-title    { font-size:1.05rem; font-weight:900; color:#fff; text-transform:uppercase; letter-spacing:.08em; text-shadow:0 2px 8px rgba(0,0,0,.4); }
    .an-subtitle { font-size:.65rem; color:rgba(255,255,255,.65); font-weight:500; margin-top:.05rem; }

    .an-badges { display:flex; gap:.5rem; flex-wrap:wrap; }
    .badge-ai, .badge-live { font-size:.62rem; font-weight:700; padding:.25rem .7rem; border-radius:2rem; white-space:nowrap; }
    .badge-ai   { background:rgba(255,255,255,.15); color:#e9d5ff; border:1px solid rgba(255,255,255,.2); }
    .badge-live { background:linear-gradient(135deg,#f59e0b,#ef4444); color:#fff; border:none;
                  box-shadow:0 2px 8px rgba(239,68,68,.5); animation:pulse-live 2s ease-in-out infinite; }
    @keyframes pulse-live { 0%,100%{box-shadow:0 2px 8px rgba(239,68,68,.5)} 50%{box-shadow:0 2px 16px rgba(239,68,68,.8)} }

    .an-tabs { display:flex; gap:.4rem; flex-wrap:wrap; padding:.3rem 1.4rem .6rem; position:relative; z-index:1; }

    .an-panel {
        margin:0 1rem .5rem; background:rgba(255,255,255,.08);
        backdrop-filter:blur(8px); border:1px solid rgba(255,255,255,.12);
        border-radius:1rem; padding:1rem 1.1rem .9rem;
        position:relative; z-index:1;
        animation:pan-in .25s ease both;
    }
    @keyframes pan-in { from{opacity:0;transform:translateY(4px)} to{opacity:1;transform:translateY(0)} }

    .an-cols { display:flex; gap:1.25rem; flex-wrap:wrap; }
    .an-col-text { flex:1; min-width:180px; display:flex; flex-direction:column; gap:.6rem; }
    .an-text-block { display:flex; align-items:flex-start; gap:.5rem; }
    .block-icon { font-size:1rem; line-height:1.5; flex-shrink:0; }
    .an-text-block p { font-size:.82rem; color:rgba(255,255,255,.88); line-height:1.6; margin:0; }

    .an-col-sugs { flex-shrink:0; max-width:280px; animation:pan-in .3s ease both; }
    .sugs-header { font-size:.62rem; font-weight:800; text-transform:uppercase; letter-spacing:.08em; color:#fde68a; margin-bottom:.6rem; }
    .sugs-disclaimer { font-size:.58rem; color:rgba(255,255,255,.45); margin-top:.55rem; font-style:italic; line-height:1.4; }

    /* Combo (una sugerencia) */
    .an-combo { display:flex; gap:.35rem; flex-wrap:wrap; margin-bottom:.5rem; align-items:center; }
    .an-combo:last-child { margin-bottom:0; }

    .an-cta {
        display:flex; align-items:center; gap:1rem; flex-wrap:wrap;
        padding:.7rem 1.4rem 1rem; position:relative; z-index:1;
    }
    .an-btn {
        display:inline-flex; align-items:center; gap:.4rem;
        background:linear-gradient(135deg,#f59e0b,#ef4444);
        color:#fff; font-size:.85rem; font-weight:900;
        padding:.55rem 1.4rem; border-radius:2rem; border:none; cursor:pointer;
        box-shadow:0 4px 16px rgba(239,68,68,.5);
        letter-spacing:.02em; text-transform:uppercase;
        transition:transform .15s ease, box-shadow .15s ease;
        animation:cta-pulse 3s ease-in-out infinite;
    }
    @keyframes cta-pulse {
        0%,100% { box-shadow:0 4px 16px rgba(239,68,68,.5); }
        50%      { box-shadow:0 6px 28px rgba(239,68,68,.75); }
    }
    .an-btn:hover  { transform:translateY(-2px) scale(1.03); }
    .an-btn:active { transform:translateY(0) scale(1); }
    /* Teaser bloqueado */
    .an-teaser {
        display:flex; align-items:center; gap:.75rem;
        padding:.25rem 0;
    }
    .teaser-icon { font-size:1.6rem; flex-shrink:0; opacity:.85; }
    .teaser-txt {
        font-size:.82rem; color:rgba(255,255,255,.7);
        line-height:1.55; margin:0; font-style:italic;
    }

    .an-locked { display:flex; flex-direction:column; gap:.45rem; align-items:flex-start; }
    .an-revealed-msg { display:flex; flex-direction:column; gap:.35rem; align-items:flex-start; }
    .an-revealed-tag {
        display:inline-flex; align-items:center; gap:.4rem;
        font-size:.85rem; font-weight:800; color:#4ade80;
        text-shadow:0 0 12px rgba(74,222,128,.5);
    }
    .an-cta-hint { font-size:.62rem; color:rgba(255,255,255,.55); font-style:italic; line-height:1.4; }

    .an-error {
        font-size:.8rem; color:#9ca3af; padding:.8rem 1rem;
        border:1px dashed rgba(0,0,0,.1); border-radius:1rem; text-align:center;
    }

    @media (max-width:600px) {
        .an-top { padding:.85rem 1rem .5rem; }
        .an-tabs { padding:.3rem 1rem .5rem; }
        .an-panel { margin:0 .75rem .4rem; }
        .an-cta { padding:.6rem 1rem .85rem; }
        .an-badges { display:none; }
        .an-col-sugs { max-width:100%; }
    }
</style>

<style is:global>
    #analizador-root .an-tab-btn {
        font-size:.7rem; font-weight:800; text-transform:uppercase; letter-spacing:.05em;
        padding:.3rem .8rem; border-radius:.6rem;
        border:1px solid rgba(255,255,255,.2); background:rgba(255,255,255,.08);
        color:rgba(255,255,255,.65); cursor:pointer;
        transition:background .15s, color .15s, border-color .15s;
    }
    #analizador-root .an-tab-btn:hover { background:rgba(255,255,255,.15); color:#fff; }
    #analizador-root .an-tab-btn.active {
        background:linear-gradient(135deg,rgba(251,191,36,.25),rgba(245,158,11,.15));
        color:#fde68a; border-color:rgba(251,191,36,.55); font-weight:900;
    }

    /* Bola numérica — redonda */
    #analizador-root .an-ball-num {
        width:2.6rem; height:2.6rem; border-radius:50%; flex-shrink:0;
        display:flex; align-items:center; justify-content:center;
        font-size:.92rem; font-weight:900; color:#1e1b4b;
        background:radial-gradient(circle at 35% 28%, #fff 0%, #fde68a 35%, #f59e0b 70%, #b45309 100%);
        box-shadow:0 4px 12px rgba(245,158,11,.6), inset 0 -3px 6px rgba(0,0,0,.15), inset 0 2px 5px rgba(255,255,255,.7);
        animation:ball-pop .45s cubic-bezier(.34,1.56,.64,1) both;
    }
    /* Bola de texto (signo, multiplicador) — píldora */
    #analizador-root .an-ball-txt {
        height:2.6rem; padding:0 .7rem; border-radius:1.3rem; flex-shrink:0;
        display:flex; align-items:center; justify-content:center;
        font-size:.75rem; font-weight:900; color:#fff; white-space:nowrap;
        background:radial-gradient(circle at 35% 28%, rgba(255,255,255,.3) 0%, #7c3aed 50%, #4c1d95 100%);
        box-shadow:0 4px 12px rgba(124,58,237,.5), inset 0 -3px 6px rgba(0,0,0,.2), inset 0 2px 5px rgba(255,255,255,.3);
        animation:ball-pop .45s cubic-bezier(.34,1.56,.64,1) both;
    }
    @keyframes ball-pop {
        from { opacity:0; transform:scale(.2) rotate(-20deg); }
        to   { opacity:1; transform:scale(1)  rotate(0); }
    }
</style>

<script>
import { fetchJSON } from '../scripts/api.js';

(async () => {
    const skeleton   = document.getElementById('an-skeleton')    as HTMLElement;
    const card       = document.getElementById('an-card')        as HTMLElement;
    const errorEl    = document.getElementById('an-error')       as HTMLElement;
    const tabsEl     = document.getElementById('an-tabs')        as HTMLElement;
    const patronesEl = document.getElementById('an-patrones')    as HTMLElement;
    const tendEl     = document.getElementById('an-tendencias')  as HTMLElement;
    const sugsEl     = document.getElementById('an-sugs')        as HTMLElement;
    const combosWrap = document.getElementById('an-combos-wrap') as HTMLElement;
    const advEl      = document.getElementById('an-advertencia') as HTMLElement;
    const btn        = document.getElementById('an-btn')         as HTMLButtonElement;
    const panelEl    = document.getElementById('an-panel')       as HTMLElement;

    const LABELS: Record<string,string> = {
        juga3:'🎲 Jugá 3', pega_3:'🎯 Pega 3', premia2:'⭐ Premia 2',
        la_diaria:'🌟 La Diaria', super_premio:'🏆 Súper Premio'
    };

    let juegosData: Record<string,any> = {};
    let activeKey = '';
    let activeRevealed = false;  // se resetea en cada cambio de tab

    const lockedEl  = document.getElementById('an-locked')       as HTMLElement;
    const revMsgEl  = document.getElementById('an-revealed-msg') as HTMLElement;
    const teaserEl  = document.getElementById('an-teaser')       as HTMLElement;
    const colsEl    = document.getElementById('an-cols')         as HTMLElement;

    function crearBola(val: string|number, delay: number): HTMLElement {
        const s = String(val).trim();
        const esNum = /^\d+$/.test(s);
        const el = document.createElement('div');
        el.className = esNum ? 'an-ball-num' : 'an-ball-txt';
        el.textContent = s;
        el.style.animationDelay = `${delay}s`;
        return el;
    }

    function renderSugerencias(sugs: any[]) {
        combosWrap.innerHTML = '';
        if (!sugs.length) { sugsEl.style.display = 'none'; return; }
        const esAnidado = Array.isArray(sugs[0]);
        if (esAnidado) {
            (sugs as any[][]).forEach((combo, ci) => {
                const row = document.createElement('div');
                row.className = 'an-combo';
                combo.forEach((v, ni) => row.appendChild(crearBola(v, ci * 0.15 + ni * 0.08)));
                combosWrap.appendChild(row);
            });
        } else {
            const chunkSize = sugs.length >= 6 ? 3 : sugs.length;
            for (let i = 0; i < sugs.length; i += chunkSize) {
                const row = document.createElement('div');
                row.className = 'an-combo';
                sugs.slice(i, i + chunkSize).forEach((v, ni) =>
                    row.appendChild(crearBola(v, (i / chunkSize) * 0.15 + ni * 0.08)));
                combosWrap.appendChild(row);
            }
        }
        sugsEl.style.display = 'block';
    }

    function mostrarBloqueado() {
        teaserEl.style.display  = 'flex';
        colsEl.style.display    = 'none';
        sugsEl.style.display    = 'none';
        lockedEl.style.display  = 'flex';
        revMsgEl.style.display  = 'none';
        btn.innerHTML = '🎰 Ver sugerencias de hoy';
    }

    function mostrarRevelado(d: any) {
        patronesEl.textContent = d.patrones   || '';
        tendEl.textContent     = d.tendencias || '';
        teaserEl.style.display  = 'none';
        colsEl.style.display    = 'flex';
        renderSugerencias(d.sugerencias || []);
        if (d.advertencia) advEl.textContent = '⚠️ ' + d.advertencia;
        lockedEl.style.display  = 'none';
        revMsgEl.style.display  = 'flex';
    }

    function renderPanel(key: string) {
        const d = juegosData[key];
        if (!d) return;
        panelEl.style.animation = 'none';
        void panelEl.offsetWidth;
        panelEl.style.animation = '';
        if (activeRevealed) {
            mostrarRevelado(d);
        } else {
            mostrarBloqueado();
        }
    }

    function activarTab(key: string) {
        // Cambiar tab siempre resetea el estado revelado
        activeKey      = key;
        activeRevealed = false;
        tabsEl.querySelectorAll<HTMLButtonElement>('.an-tab-btn').forEach(b => {
            b.classList.toggle('active', b.dataset.key === key);
        });
        renderPanel(key);
    }

    try {
        const data = await fetchJSON('/api/analizar');
        if (!data?.juegos) throw new Error('Sin datos');

        juegosData = data.juegos;

        if (data.fecha) {
            const [y,m,d] = (data.fecha as string).split('-').map(Number);
            const dias  = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
            const meses = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
            const f = new Date(y, m-1, d);
            (document.getElementById('an-fecha') as HTMLElement).textContent =
                `${dias[f.getDay()]} ${d} de ${meses[m-1]}`;
        }

        Object.keys(juegosData).forEach(key => {
            const b = document.createElement('button');
            b.className = 'an-tab-btn';
            b.dataset.key = key;
            b.textContent = LABELS[key] || key;
            b.setAttribute('role','tab');
            b.addEventListener('click', () => activarTab(key));
            tabsEl.appendChild(b);
        });

        const keys = Object.keys(juegosData);
        if (keys.length) activarTab(keys[0]);

        // Clic en botón: revela sugerencias del juego activo
        btn.addEventListener('click', () => {
            activeRevealed = true;
            renderPanel(activeKey);
        });

        skeleton.style.display = 'none';
        card.style.display     = 'block';

    } catch(e) {
        console.warn('AnalizadorIA:', (e as Error).message);
        skeleton.style.display = 'none';
        errorEl.style.display  = 'block';
    }
})();
</script>
