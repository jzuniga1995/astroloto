---
// src/components/Anuncio.astro
// Un hueco publicitario en el flujo de la página.
//
// El banner NO se pinta en el HTML: sale un iframe vacío con el alto ya
// reservado y `src/scripts/anuncios.js` le mete el `srcdoc` cuando el hueco se
// acerca a la pantalla. Así el script del proveedor no bloquea el parser, no
// puede tocar el DOM del sitio y el layout no salta.
//
// `formato="nativo"` es el otro caso: ese sí va inline porque trae su propio
// contenedor, carga `async` y no usa `atOptions`. Solo uno por página — el id
// del contenedor lo fija el proveedor.
//
// `formato="enlace"` es el enlace directo de la red, y es el único hueco que no
// pide nada a un tercero: es HTML del sitio, un `<a>` rotulado que solo navega
// si el visitante lo toca. Cero scripts, cero salto de layout, cero redirección
// automática.
import { ANUNCIOS_ACTIVOS, FORMATOS, MEDIDAS, PERMISOS_IFRAME, NATIVO, ENLACE_DIRECTO } from '../lib/anuncios.js';

const {
    formato = 'lider',
    etiqueta = true,
    class: clase = '',
    // Solo para `formato="enlace"`: el texto de la tarjeta. Por defecto el de
    // la librería; cada hueco puede decir lo que corresponda en su contexto,
    // pero el aviso de que abre un anuncio nunca se quita.
    titulo = ENLACE_DIRECTO.titulo,
    detalle = ENLACE_DIRECTO.detalle,
} = Astro.props;

const esNativo = formato === 'nativo';
const esEnlace = formato === 'enlace';
const cfg = FORMATOS[formato];
const mostrar = ANUNCIOS_ACTIVOS && (esNativo || esEnlace || Boolean(cfg));

const escritorio = cfg?.escritorio ? MEDIDAS[cfg.escritorio] : null;
const movil = cfg?.movil ? MEDIDAS[cfg.movil] : null;

// Solo hay medida en un tamaño de pantalla → en el otro el hueco no existe.
const soloEn = !movil ? 'escritorio' : !escritorio ? 'movil' : 'ambos';

const vars = [
    escritorio && `--anch-e:${escritorio.ancho}px`,
    escritorio && `--alto-e:${escritorio.alto}px`,
    movil && `--anch-m:${movil.ancho}px`,
    movil && `--alto-m:${movil.alto}px`,
].filter(Boolean).join(';');
---

{mostrar && (esEnlace ? (
    <aside class={`anuncio anuncio--enlace ${clase}`} aria-label="Publicidad">
        {etiqueta && <span class="anuncio-etiqueta">Publicidad</span>}
        <a
            class="anuncio-enlace"
            href={ENLACE_DIRECTO.url}
            target="_blank"
            rel="nofollow sponsored noopener"
        >
            <span class="anuncio-enlace-texto">
                <strong>{titulo}</strong>
                <small>{detalle}</small>
            </span>
            <span class="anuncio-enlace-flecha" aria-hidden="true">&rarr;</span>
        </a>
    </aside>
) : esNativo ? (
    <aside class={`anuncio anuncio--nativo ${clase}`} aria-label="Publicidad">
        {etiqueta && <span class="anuncio-etiqueta">Publicidad</span>}
        <div id={NATIVO.contenedor}></div>
        <script async data-cfasync="false" src={NATIVO.src} is:inline></script>
    </aside>
) : (
    <aside
        class={`anuncio ${clase}`}
        data-solo={soloEn}
        style={vars}
        aria-label="Publicidad"
    >
        {etiqueta && <span class="anuncio-etiqueta">Publicidad</span>}
        <iframe
            class="anuncio-marco"
            data-anuncio={formato}
            sandbox={PERMISOS_IFRAME}
            scrolling="no"
            frameborder="0"
            loading="lazy"
            title="Publicidad"
            aria-hidden="true"
            tabindex="-1"
        ></iframe>
    </aside>
))}

<style is:global>
    .anuncio {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        margin: 1.5rem auto;
        max-width: 100%;
        /* Ningún creativo se sale de su caja ni empuja el resto de la página. */
        overflow: hidden;
    }

    .anuncio-etiqueta {
        font-size: 0.625rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #a78bfa;
        line-height: 1;
    }

    .anuncio-marco {
        display: block;
        border: 0;
        max-width: 100%;
        /* El alto se reserva desde el HTML: sin esto el creativo entra de golpe
           y desplaza todo lo que tiene debajo (CLS). */
        width: var(--anch-e, 300px);
        height: var(--alto-e, 250px);
    }

    @media (max-width: 799px) {
        .anuncio-marco {
            width: var(--anch-m, 300px);
            height: var(--alto-m, 250px);
        }
        .anuncio[data-solo='escritorio'] { display: none; }
    }

    @media (min-width: 800px) {
        .anuncio[data-solo='movil'] { display: none; }
    }

    /* El nativo trae su propio alto; se le reserva un mínimo para que la
       aparición no mueva el contenido de abajo. */
    .anuncio--nativo {
        width: 100%;
        min-height: 260px;
    }
    .anuncio--nativo > div { width: 100%; }

    /* ---------- Enlace patrocinado ----------
       Discreto a propósito: una tarjeta del ancho del texto, no un bloque que
       compita con los resultados. Va rotulada y se abre en otra pestaña. */
    .anuncio--enlace { width: 100%; }

    .anuncio-enlace {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        width: 100%;
        max-width: 420px;
        padding: 0.7rem 0.9rem;
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid #ede9fe;
        border-radius: 0.75rem;
        box-shadow: 0 1px 6px rgba(76, 29, 149, 0.08);
        color: #4c1d95;
        text-decoration: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    }

    .anuncio-enlace:hover,
    .anuncio-enlace:focus-visible {
        border-color: #c4b5fd;
        box-shadow: 0 3px 12px rgba(76, 29, 149, 0.14);
        transform: translateY(-1px);
    }

    .anuncio-enlace-texto {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 0;
    }
    .anuncio-enlace-texto strong {
        font-family: var(--font-display, inherit);
        font-size: 0.9rem;
        font-weight: 700;
    }
    .anuncio-enlace-texto small {
        font-size: 0.72rem;
        line-height: 1.3;
        color: #7c6bb0;
    }

    .anuncio-enlace-flecha {
        flex: none;
        font-size: 1.05rem;
        font-weight: 700;
        color: #7c3aed;
    }
</style>
